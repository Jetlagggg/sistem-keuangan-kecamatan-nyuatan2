      "css": ".ds-tag{display:inline-block;padding:2px 6px;border:1px solid #c6cbc0;border-radius:0;background:transparent;color:#3d443e;font-family:\"Roboto Mono\",monospace;font-size:9px;font-weight:500;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}.ds-tag-red{border-color:#a33b2e;color:#a33b2e}.ds-tag-green{border-color:#2f5b45;color:#2f5b45}.ds-tag-solid{background:#1b211c;border-color:#1b211c;color:#fbfaf4}"
