      "html": "<table class=\"ds-table\"><thead><tr><th>TANGGAL</th><th>URAIAN</th><th class=\"ds-num\">NOMINAL</th><th class=\"ds-balance\">SALDO KAS</th></tr></thead><tbody><tr><td class=\"ds-date\">22/10/2026</td><td>Perjalanan dinas</td><td class=\"ds-num\">Rp 314.000.000</td><td class=\"ds-balance\">Rp 381.000.000</td></tr></tbody></table>",
