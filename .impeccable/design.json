      "css": ".ds-sheet{background:#fbfaf4;color:#1b211c;border:1px solid #c6cbc0;border-radius:0}.ds-sheet-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:10px 16px;border-bottom:1px solid #1b211c}.ds-sheet-title{margin:0;font-family:\"Public Sans\",sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ds-sheet-meta{font-family:\"Roboto Mono\",monospace;font-size:9.5px;color:#63695f;text-align:right}.ds-sheet-body{padding:16px;font-size:12.5px}.ds-sheet-foot{display:flex;justify-content:flex-end;gap:24px;padding:9px 16px;border-top:3px double #1b211c;font-family:\"Roboto Mono\",monospace;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase}.ds-sheet-foot b{font-size:12px;letter-spacing:0}"
    },
    {
      "name": "Summary Band",
      "kind": "custom",
      "refersTo": "summary-value",
      "description": "Three-column headline strip for pagu, terserap, and sisa; stacks on mobile.",
      "html": "<div class=\"ds-summary\"><div class=\"ds-summary-cell\"><div class=\"ds-summary-label\">TOTAL PAGU KANTOR</div><div class=\"ds-summary-value\">Rp 705.000.000</div><div class=\"ds-summary-note\">Akumulasi dana masuk</div></div><div class=\"ds-summary-cell\"><div class=\"ds-summary-label\">TOTAL TERSERAP</div><div class=\"ds-summary-value\">Rp 324.000.000</div><div class=\"ds-summary-note\">46,0% terealisasi</div></div><div class=\"ds-summary-cell ds-negative\"><div class=\"ds-summary-label\">SISA ALOKASI</div><div class=\"ds-summary-value\">Rp 341.000.000</div><div class=\"ds-summary-note\">Dana belum dibagi</div></div></div>",
      "css": ".ds-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fbfaf4;border:1px solid #a9bccd;border-top:2px solid #1b211c}.ds-summary-cell{padding:13px 18px 15px;border-left:1px solid #c6cbc0;min-width:0}.ds-summary-cell:first-child{border-left:0}.ds-summary-label{font-family:\"Roboto Mono\",monospace;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:#63695f}.ds-summary-value{margin-top:5px;font-family:\"Roboto Mono\",monospace;font-size:27px;font-weight:700;line-height:1.15;letter-spacing:-.03em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ds-summary-note{margin-top:4px;font-size:11px;color:#63695f}.ds-negative{background:repeating-linear-gradient(135deg,rgba(163,59,46,.055) 0 1px,transparent 1px 7px)}.ds-negative .ds-summary-value,.ds-negative .ds-summary-note{color:#a33b2e}"
    },
